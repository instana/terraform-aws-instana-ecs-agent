# ==============================================================================
# Complete Example - Terraform Variables
# ==============================================================================
#
# Copy this file to terraform.tfvars and update with your actual values.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform init
#   terraform apply
#
# ==============================================================================

# AWS Configuration
region = "us-east-1"

# Network Configuration (Required)
vpc_id  = "vpc-xxxxxxxxx"
subnets = ["subnet-xxxxxxxxx", "subnet-yyyyyyyyy"]

# Public IP Assignment
# Set to true for public subnets, false for private subnets (requires NAT Gateway)
assign_public_ip = true

# ECS Cluster Configuration
# Option 1: Use existing cluster
create_ecs_cluster = false
ecs_cluster        = "my-existing-cluster"

# Option 2: Create new cluster (uncomment and comment above)
# create_ecs_cluster = true
# cluster_name       = "instana-sensor-cluster"

# Security Group Configuration
# Option 1: Create new security group
create_security_group = true

# Option 2: Use existing security group (uncomment and comment above)
# create_security_group = false
# security_group_id     = "sg-xxxxxxxxx"

# Instana Configuration (Required)
instana_agent_key = "your-instana-agent-key-here"

# Optional: Separate download key (usually same as agent key)
# instana_download_key = "your-download-key"

instana_endpoint      = "ingress-blue-saas.instana.io"
instana_endpoint_port = 443
